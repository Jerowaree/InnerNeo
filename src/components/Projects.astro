---
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const isEnglish = lang === "en";

const copy = isEnglish
  ? {
      label: "Digital solutions",
      title: "Your business deserves a better digital experience.",
      description:
        "We design and develop websites that make your business easier to understand, trust and choose.",
      intro: "Built around your goals",
      cta: "Let's build yours",
      trust: ["Strategy first", "Made to convert", "Close support"],
    }
  : {
      label: "Soluciones digitales",
      title: "Tu negocio merece una mejor experiencia digital.",
      description:
        "Diseñamos y desarrollamos webs que hacen que tu negocio sea más fácil de entender, confiar y elegir.",
      intro: "Construidas alrededor de tus objetivos",
      cta: "Construyamos la tuya",
      trust: ["Estrategia primero", "Pensadas para convertir", "Acompañamiento cercano"],
    };

const solutions = isEnglish
  ? [
      {
        number: "01",
        type: "For growing brands",
        title: "Corporate website",
        description: "Turn your online presence into a clear, credible introduction to your business.",
        bullets: ["Position your brand", "Explain your value", "Be found more easily"],
        visual: "corporate",
        image: "/images/corporativa.png",
        alt: "Corporate website example",
      },
      {
        number: "02",
        type: "For paid campaigns",
        title: "Conversion landing page",
        description: "Give every campaign a focused destination designed to create more conversations.",
        bullets: ["One clear message", "WhatsApp and forms", "Ready for Meta Ads"],
        visual: "landing",
        image: "/images/landing.jpeg",
        alt: "Landing page example",
      },
      {
        number: "03",
        type: "For ambitious ideas",
        title: "Online store or platform",
        description: "Make it simpler for people to buy, book or interact with your business.",
        bullets: ["Custom user flows", "Payments and integrations", "Ready to grow"],
        visual: "platform",
        image: "/images/ecommerce.png",
        alt: "Online store example",
      },
    ]
  : [
      {
        number: "01",
        type: "Para marcas en crecimiento",
        title: "Web corporativa",
        description: "Convierte tu presencia online en una presentación clara y confiable de tu negocio.",
        bullets: ["Posiciona tu marca", "Explica tu valor", "Hazte más visible"],
        visual: "corporate",
        image: "/images/corporativa.png",
        alt: "Ejemplo de web corporativa",
      },
      {
        number: "02",
        type: "Para campañas de publicidad",
        title: "Landing page que convierte",
        description: "Dale a cada campaña un destino enfocado en generar más conversaciones.",
        bullets: ["Un mensaje claro", "WhatsApp y formularios", "Lista para Meta Ads"],
        visual: "landing",
        image: "/images/landing.jpeg",
        alt: "Ejemplo de landing page",
      },
      {
        number: "03",
        type: "Para ideas ambiciosas",
        title: "Tienda online o plataforma",
        description: "Haz más sencillo que las personas compren, reserven o interactúen con tu negocio.",
        bullets: ["Flujos personalizados", "Pagos e integraciones", "Lista para crecer"],
        visual: "platform",
        image: "/images/ecommerce.png",
        alt: "Ejemplo de tienda online",
      },
    ];
---

<section id="projects" class="relative overflow-hidden bg-[#FBF7F2] py-24 sm:py-32" aria-labelledby="projects-title">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[#25245A]/10"></div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="mb-14 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="reveal mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#4D49B9]">{copy.label}</p>
        <h2 id="projects-title" class="reveal max-w-2xl text-4xl font-mont font-semibold leading-[1.05] tracking-tight text-[#1C1B2C] sm:text-5xl lg:text-6xl">
          {isEnglish ? "Your business deserves" : "Tu negocio merece"}
          <span class="block text-[#3F3B9E]">{isEnglish ? "a better digital experience." : "una mejor experiencia digital."}</span>
        </h2>
      </div>

      <div class="reveal max-w-md lg:pb-2">
        <p class="text-base font-medium leading-relaxed text-[#25245A]/75">{copy.description}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-semibold uppercase tracking-[0.12em] text-[#25245A]">
          {copy.trust.map((item, index) => (
            <Fragment>
              {index > 0 && <span class="h-1 w-1 rounded-full bg-[#FDCB45]"></span>}
              <span>{item}</span>
            </Fragment>
          ))}
        </div>
      </div>
    </div>

    <div class="mb-6 flex items-center gap-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#25245A]/60">
      <span>{copy.intro}</span>
      <span class="h-px flex-1 bg-[#25245A]/12"></span>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {solutions.map((solution, index) => (
        <article class:list={["solution-card reveal group overflow-hidden border border-[#25245A]/12 bg-white/55 transition-all duration-500 hover:-translate-y-1 hover:border-[#4D49B9]/40 hover:bg-white/80", index === 1 && "delay-150", index === 2 && "delay-300"]}>
          <div class="solution-preview relative h-52 overflow-hidden border-b border-[#25245A]/10 bg-[#1C1B2C] p-4" data-visual={solution.visual}>
            <div class="browser-window relative h-full overflow-hidden bg-white shadow-lg">
              <div class="flex h-7 items-center gap-1.5 border-b border-[#25245A]/10 bg-[#FBF7F2] px-3">
                <span class="h-1.5 w-1.5 rounded-full bg-[#25245A]/20"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-[#25245A]/20"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-[#25245A]/20"></span>
                <span class="ml-2 h-2 w-24 bg-[#25245A]/8"></span>
              </div>
              <img
                src={solution.image}
                alt={solution.alt}
                loading="lazy"
                class="h-[calc(100%-1.75rem)] w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <span class="absolute right-5 top-5 text-xs font-semibold tracking-[0.2em] text-[#FDCB45]">{solution.number}</span>
          </div>

          <div class="p-6 sm:p-7">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.16em] text-[#4D49B9]">{solution.type}</p>
            <h3 class="text-xl font-semibold leading-tight tracking-tight text-[#1C1B2C]">{solution.title}</h3>
            <p class="mt-3 min-h-[4.5rem] text-sm leading-6 text-[#25245A]/75">{solution.description}</p>
            <ul class="mt-5 space-y-2 border-t border-[#25245A]/10 pt-4">
              {solution.bullets.map((bullet) => (
                <li class="flex items-center gap-3 text-sm font-medium text-[#25245A]"><span class="text-base leading-none text-[#FDCB45]">+</span>{bullet}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="reveal delay-300 mt-12 flex flex-col gap-6 border-t border-[#25245A]/12 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-2xl font-semibold leading-tight text-[#1C1B2C] sm:text-3xl">{copy.title}</p>
      <a href={translatePath("/contacto")} class="group inline-flex shrink-0 items-center justify-center gap-3 rounded-sm bg-[#3F3B9E] px-7 py-4 text-sm font-semibold uppercase tracking-[0.04em] text-white transition-all duration-300 hover:bg-[#25245A]">
        {copy.cta}
        <svg class="transition-transform duration-300 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
  });
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  .solution-preview::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(77, 73, 185, 0.12), transparent 60%);
    content: "";
    pointer-events: none;
  }

  .solution-card:hover .solution-preview::after {
    background: linear-gradient(135deg, rgba(253, 203, 69, 0.2), transparent 65%);
  }

  .delay-150 {
    transition-delay: 0.12s;
  }

  .delay-300 {
    transition-delay: 0.24s;
  }
</style>
