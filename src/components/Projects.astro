---
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const isEnglish = lang === "en";

const copy = isEnglish
  ? {
      label: "Digital solutions",
      title: "Your business deserves a better digital experience.",
      description:
        "We design and develop websites that make your business easier to understand, trust and choose.",
      intro: "Built around your goals",
      cta: "Let's build yours",
      trust: ["Strategy first", "Made to convert", "Close support"],
    }
  : {
      label: "Soluciones digitales",
      title: "Tu negocio merece una mejor experiencia digital.",
      description:
        "Diseñamos y desarrollamos webs que hacen que tu negocio sea más fácil de entender, confiar y elegir.",
      intro: "Construidas alrededor de tus objetivos",
      cta: "Construyamos la tuya",
      trust: ["Estrategia primero", "Pensadas para convertir", "Acompañamiento cercano"],
    };

const solutions = isEnglish
  ? [
      {
        number: "01",
        type: "For growing brands",
        title: "Corporate website",
        description: "Turn your online presence into a clear, credible introduction to your business.",
        bullets: ["Position your brand", "Explain your value", "Be found more easily"],
        visual: "corporate",
        image: "/images/corporativa.png",
        alt: "Corporate website example",
      },
      {
        number: "02",
        type: "For paid campaigns",
        title: "Conversion landing page",
        description: "Give every campaign a focused destination designed to create more conversations.",
        bullets: ["One clear message", "WhatsApp and forms", "Ready for Meta Ads"],
        visual: "landing",
        image: "/images/landing.jpeg",
        alt: "Landing page example",
      },
      {
        number: "03",
        type: "For ambitious ideas",
        title: "Online store or platform",
        description: "Make it simpler for people to buy, book or interact with your business.",
        bullets: ["Custom user flows", "Payments and integrations", "Ready to grow"],
        visual: "platform",
        image: "/images/ecommerce.png",
        alt: "Online store example",
      },
    ]
  : [
      {
        number: "01",
        type: "Para marcas en crecimiento",
        title: "Web corporativa",
        description: "Convierte tu presencia online en una presentación clara y confiable de tu negocio.",
        bullets: ["Posiciona tu marca", "Explica tu valor", "Hazte más visible"],
        visual: "corporate",
        image: "/images/corporativa.png",
        alt: "Ejemplo de web corporativa",
      },
      {
        number: "02",
        type: "Para campañas de publicidad",
        title: "Landing page que convierte",
        description: "Dale a cada campaña un destino enfocado en generar más conversaciones.",
        bullets: ["Un mensaje claro", "WhatsApp y formularios", "Lista para Meta Ads"],
        visual: "landing",
        image: "/images/landing.jpeg",
        alt: "Ejemplo de landing page",
      },
      {
        number: "03",
        type: "Para ideas ambiciosas",
        title: "Tienda online o plataforma",
        description: "Haz más sencillo que las personas compren, reserven o interactúen con tu negocio.",
        bullets: ["Flujos personalizados", "Pagos e integraciones", "Lista para crecer"],
        visual: "platform",
        image: "/images/ecommerce.png",
        alt: "Ejemplo de tienda online",
      },
    ];
---

<section id="projects" class="relative overflow-hidden bg-white py-24 sm:py-32" aria-labelledby="projects-title">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[#0F0F1A]/10"></div>
  <div class="pointer-events-none absolute -right-24 top-32 h-72 w-72 rounded-full bg-[#612DAA]/8 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 left-[-8rem] h-80 w-80 rounded-full bg-[#A78BFA]/10 blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-6">
    <div class="mb-16 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-4xl">
        <p class="reveal mb-6 text-sm font-bold uppercase tracking-[0.28em] text-[#612DAA]">{copy.label}</p>
        <h2 id="projects-title" class="reveal max-w-4xl text-4xl font-mont font-black leading-[0.98] tracking-tight text-[#0F0F1A] sm:text-6xl lg:text-[5rem]">
          {isEnglish ? "Your business deserves" : "Tu negocio merece"}
          <span class="block text-[#612DAA]">{isEnglish ? "a better digital experience." : "una mejor experiencia digital."}</span>
        </h2>
      </div>

      <div class="reveal max-w-md lg:pb-2">
        <p class="text-lg font-medium leading-relaxed text-[#64748B]">{copy.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-bold uppercase tracking-[0.14em] text-[#0F0F1A]">
          {copy.trust.map((item, index) => (
            <Fragment>
              {index > 0 && <span class="h-1 w-1 rounded-full bg-[#612DAA]"></span>}
              <span>{item}</span>
            </Fragment>
          ))}
        </div>
      </div>
    </div>

    <div class="mb-7 flex items-center gap-4 text-xs font-bold uppercase tracking-[0.25em] text-[#64748B]">
      <span>{copy.intro}</span>
      <span class="h-px flex-1 bg-[#0F0F1A]/12"></span>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {solutions.map((solution, index) => (
        <article class:list={["solution-card reveal group overflow-hidden border border-[#0F0F1A]/10 bg-[#F8FAFF] transition-all duration-500 hover:-translate-y-2 hover:border-[#612DAA]/35 hover:shadow-[0_24px_60px_rgba(97,45,170,0.13)]", index === 1 && "delay-150", index === 2 && "delay-300"]}>
          <div class="solution-preview relative h-56 overflow-hidden border-b border-[#0F0F1A]/10 bg-[#0F0F1A] p-5" data-visual={solution.visual}>
            <div class="browser-window relative h-full overflow-hidden bg-white shadow-2xl">
              <div class="flex h-7 items-center gap-1.5 border-b border-[#0F0F1A]/10 bg-[#F8FAFF] px-3">
                <span class="h-1.5 w-1.5 rounded-full bg-[#0F0F1A]/20"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-[#0F0F1A]/20"></span>
                <span class="h-1.5 w-1.5 rounded-full bg-[#0F0F1A]/20"></span>
                <span class="ml-2 h-2 w-24 bg-[#0F0F1A]/8"></span>
              </div>
              <img
                src={solution.image}
                alt={solution.alt}
                loading="lazy"
                class="h-[calc(100%-1.75rem)] w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <span class="absolute right-6 top-6 text-xs font-black tracking-[0.2em] text-white/60">{solution.number}</span>
          </div>

          <div class="p-7 sm:p-8">
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.2em] text-[#612DAA]">{solution.type}</p>
            <h3 class="text-2xl font-black leading-tight tracking-tight text-[#0F0F1A]">{solution.title}</h3>
            <p class="mt-4 min-h-[5rem] text-[15px] leading-7 text-[#64748B]">{solution.description}</p>
            <ul class="mt-6 space-y-3 border-t border-[#0F0F1A]/10 pt-5">
              {solution.bullets.map((bullet) => (
                <li class="flex items-center gap-3 text-sm font-bold text-[#394252]"><span class="text-lg leading-none text-[#612DAA]">+</span>{bullet}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="reveal delay-300 mt-12 flex flex-col gap-6 border-t border-[#0F0F1A]/12 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xl text-2xl font-black leading-tight text-[#0F0F1A] sm:text-3xl">{copy.title}</p>
      <a href={translatePath("/contacto")} class="group inline-flex shrink-0 items-center justify-center gap-3 rounded-lg bg-[#612DAA] px-7 py-4 text-sm font-black uppercase tracking-[0.16em] text-white shadow-lg shadow-[#612DAA]/15 transition-all duration-300 hover:scale-[1.03] hover:bg-[#4F2490]">
        {copy.cta}
        <svg class="transition-transform duration-300 group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
  });
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .reveal.active {
    opacity: 1;
    transform: translateY(0);
  }

  .solution-preview::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(97, 45, 170, 0.1), transparent 55%);
    content: "";
    pointer-events: none;
  }

  .solution-card:hover .solution-preview::after {
    background: linear-gradient(135deg, rgba(97, 45, 170, 0.28), transparent 65%);
  }

  .delay-150 {
    transition-delay: 0.12s;
  }

  .delay-300 {
    transition-delay: 0.24s;
  }
</style>
