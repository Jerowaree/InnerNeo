---
import { Image } from "astro:assets";
import heroImage from "../assets/images/rigthhero.png";
import ctaImage from "../assets/images/ctagirl.png";
import logoImage from "../assets/images/wairi_logo_primary_transparent.png";
import corporateImage from "../assets/images/corporativa.png";
import landingImage from "../assets/images/landing.jpeg";
import ecommerceImage from "../assets/images/ecommerce.png";
import cargaIcon from "../assets/images/carga.png";
import lapizIcon from "../assets/images/lapiz.png";
import codigoIcon from "../assets/images/codigo.png";
import naveIcon from "../assets/images/nave.png";
import pcIcon from "../assets/images/pc.png";
import cuboIcon from "../assets/images/cubo.png";
import carritoIcon from "../assets/images/carrito.png";
import lupaIcon from "../assets/images/lupa.png";
import escudoIcon from "../assets/images/escudo.png";
import clickIcon from "../assets/images/click.png";

const services = [
  { title: "Páginas web", text: "Sitios web que transmiten confianza y generan resultados.", icon: pcIcon },
  { title: "Sistemas a medida", text: "Software que se adapta a tu negocio, no al revés.", icon: cuboIcon },
  { title: "Ecommerce", text: "Tiendas online listas para vender y hacer crecer tu marca.", icon: carritoIcon },
];

const projects = [
  { title: "Landing page", type: "Conversión y campañas", text: "Una página enfocada en convertir visitas en oportunidades reales.", benefits: ["Mensaje claro y directo", "Formularios y llamadas a la acción", "Preparada para campañas"], image: landingImage },
  { title: "Página corporativa", type: "Marca y confianza", text: "Una presencia digital clara para presentar el valor de un negocio.", benefits: ["Refuerza la confianza", "Presenta servicios con claridad", "Mejora tu presencia online"], image: corporateImage },
  { title: "Ecommerce", type: "Venta online", text: "Una experiencia de compra sencilla, rápida y preparada para crecer.", benefits: ["Catálogo fácil de explorar", "Compra rápida y segura", "Lista para crecer contigo"], image: ecommerceImage },
];

const process = [
  { number: "01", title: "Entendemos", text: "Tu negocio, tus objetivos y tu público.", icon: cargaIcon },
  { number: "02", title: "Diseñamos", text: "Una solución estratégica y a medida.", icon: lapizIcon },
  { number: "03", title: "Desarrollamos", text: "Con tecnología, calidad y atención al detalle.", icon: codigoIcon },
  { number: "04", title: "Lanzamos", text: "Y te acompañamos para seguir haciendo crecer tu negocio.", icon: naveIcon },
];

const currentYear = new Date().getFullYear();

const proofItems = [
  { title: "No encuentran", emphasis: "tu negocio.", text: "Si no estás, no existes para ellos.", icon: lupaIcon },
  { title: "Lo encuentran,", emphasis: "pero no confían.", text: "Una web poco profesional genera dudas.", icon: escudoIcon },
  { title: "Confían, pero no saben", emphasis: "qué hacer después.", text: "Sin una guía clara, las oportunidades se pierden.", icon: clickIcon },
];
---

<div class="reference-home">
  <header class="site-header">
    <a href="/" class="brand" aria-label="Wairi, inicio"><Image src={logoImage} alt="Wairi" width={224} height={178} /></a>
    <nav id="main-nav" aria-label="Navegación principal"><a href="#">Inicio</a><a href="#services">Servicios</a><a href="#projects">Proyectos</a><a href="#process">Nosotros</a><a href="/contacto">Contacto</a></nav>
    <a href="/contacto" class="header-button">Hablemos</a>
    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav">
      <svg class="hamburger-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <svg class="close-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </header>
  <div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>

  <main id="main-content">
    <section class="hero section-shell"><div class="hero-copy"><p class="eyebrow">CONSTRUYENDO EL SIGUIENTE PASO.</p><h1>Tu negocio merece<br /><em>más que una web</em><br />bonita.</h1><p class="hero-description">Diseñamos experiencias digitales pensadas para generar confianza, destacar tu marca y convertir visitas en oportunidades.</p><div class="hero-actions"><a class="yellow-button" href="/contacto">Quiero mejorar mi negocio <span>→</span></a><a class="text-link" href="#projects">Ver nuestros trabajos <span>→</span></a></div><p class="hero-tags">Diseño&nbsp;&nbsp;·&nbsp;&nbsp; Desarrollo&nbsp;&nbsp;·&nbsp;&nbsp; Estrategia</p></div><div class="hero-visual"><Image src={heroImage} alt="Diseño web de Wairi en laptop y móvil" width={1440} height={1080} loading="eager" /></div></section>

    <section class="intro section-shell"><div class="intro-copy"><p class="eyebrow">UN MUNDO DIGITAL MUY COMPETITIVO</p><h2>Antes de hablarte,<br />tus clientes ya te buscaron.</h2><p class="muted-copy">Y en esos primeros segundos, deciden si se quedan o se van.<br />Una presencia digital estratégica puede ser la diferencia entre pasar desapercibido<br />o convertirte en su primera opción.</p></div><div class="proof-area"><div class="proof-grid">{proofItems.map((item) => <article><span class="proof-icon"><Image src={item.icon} alt="" width={72} height={72} /></span><strong>{item.title}<br />{item.emphasis}</strong><small>{item.text}</small></article>)}</div><div class="proof-bridge"><span></span><strong>Wairi construye el camino entre <em>encontrarte y elegirte.</em></strong></div></div></section>

    <section id="services" class="content-section section-shell"><div class="section-heading"><div><p class="eyebrow">NUESTROS SERVICIOS</p><h2>Soluciones digitales para<br />negocios que quieren más.</h2></div><a class="text-link" href="/contacto">Ver todos los servicios&nbsp; →</a></div><div class="service-grid">{services.map((service) => <article class="service-card"><span class="service-icon"><Image src={service.icon} alt="" width={72} height={72} /></span><div><h3>{service.title}</h3><p>{service.text}</p></div><span class="circle-arrow">→</span></article>)}</div></section>

    <section id="projects" class="projects-section content-section section-shell"><img src="/images/curvas.png" alt="" class="projects-curvas-img" aria-hidden="true" /><div class="projects-heading"><div><p class="eyebrow">NUESTROS PROYECTOS</p><h2>Proyectos que convierten<br />ideas en resultados.</h2><p>Marcas reales, negocios que crecen. Conoce algunos de los proyectos donde la estrategia, el diseño y la tecnología se unen para generar un impacto medible.</p></div><a class="text-link" href="/contacto">Ver todos los proyectos <span>→</span></a></div><div class="project-grid">{projects.map((project) => <article class="project-card"><div class="project-image"><Image src={project.image} alt={project.title} width={720} height={420} loading="lazy" /></div><div class="project-info"><div><p class="project-type">{project.type}</p><h3>{project.title}</h3><p class="project-description">{project.text}</p></div><span class="circle-arrow">→</span></div></article>)}</div></section>

    <section id="process" class="process-section section-shell"><p class="eyebrow">NUESTRO PROCESO</p><h2>Simple, claro y enfocado en resultados.</h2><div class="process-grid">{process.map((step) => <article><span class="process-number">{step.number}</span><span class="process-symbol"><Image src={step.icon} alt="" width={104} height={104} /></span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></section>

    <section class="difference section-shell"><div class="difference-visual"><Image src={ctaImage} alt="Una emprendedora mirando hacia el futuro" width={1440} height={1080} loading="lazy" /></div><div class="difference-copy"><p class="eyebrow">NUESTRA DIFERENCIA</p><h2>No hacemos webs de plantilla.</h2><p class="difference-description">Creamos experiencias digitales únicas, alineadas con tu marca, tu público y tus objetivos comerciales.</p><div class="difference-points"><span>Estrategia real</span><span class="dot-sep" aria-hidden="true"></span><span>Diseño con propósito</span><span class="dot-sep" aria-hidden="true"></span><span>Tecnología que impulsa</span><span class="dot-sep" aria-hidden="true"></span><span>Resultados medibles</span></div><p class="difference-note">Tu visión.<br /><em>Nuestra tecnología.</em><br />Más posibilidades.</p></div><span class="difference-decoration" aria-hidden="true"></span></section>

    <section id="contact" class="final-cta section-shell"><div><p class="eyebrow">ES MOMENTO DE DAR EL SIGUIENTE PASO</p><h2>Hagamos que tu negocio se vea<br />tan bien como realmente es.</h2></div><a href="/contacto" class="yellow-button">Hablemos de tu proyecto <span>→</span></a></section>
  </main>

  <footer class="site-footer">
    <div class="footer-main">
      <div class="footer-brand"><Image src={logoImage} alt="Wairi" width={224} height={178} /><span>CONSTRUYENDO EL SIGUIENTE PASO.</span><p>Diseñamos experiencias digitales que hacen crecer negocios reales.</p></div>
      <nav class="footer-nav" aria-label="Navegación del pie de página"><div><strong>Explora</strong><a href="#main-content">Inicio</a><a href="#services">Servicios</a><a href="#projects">Proyectos</a><a href="#process">Proceso</a></div><div><strong>Soluciones</strong><a href="#services">Páginas web</a><a href="#services">Sistemas a medida</a><a href="#services">Ecommerce</a><a href="/contacto">Hablemos</a></div></nav>
      <div class="footer-contact"><strong>Conectemos</strong><a href="mailto:innerneoficial@gmail.com">innerneoficial@gmail.com</a><a href="tel:+51955730233">+51 955 730 233</a><div class="socials" aria-label="Redes sociales"><a href="https://www.instagram.com/innerneoficial/" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"></circle></svg></a><a href="https://www.tiktok.com" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.5a3.5 3.5 0 1 1-3-3.46M14 4c.7 2.2 2.1 3.5 4.5 3.7"></path></svg></a><a href="https://www.linkedin.com" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9v9M6 6v.1M10 18v-5a3 3 0 0 1 6 0v5M10 9v9"></path></svg></a></div></div>
      <div class="footer-message">Construimos<br /><em>lo que sigue.</em><span></span></div>
    </div>
    <div class="footer-bottom"><span>© {currentYear} Wairi. Todos los derechos reservados.</span><div><a href="#">Términos</a><a href="#">Privacidad</a><a href="/contacto">Contacto</a></div></div>
  </footer>
</div>

<script>
  function setupMobileMenu() {
    const menuButton = document.querySelector('.menu-button');
    const navigation = document.querySelector('.site-header nav');
    const menuBackdrop = document.getElementById('menu-backdrop');
    const hamburgerIcon = menuButton?.querySelector('.hamburger-icon');
    const closeIcon = menuButton?.querySelector('.close-icon');

    if (!menuButton || !navigation) return;

    function toggleMenu(show?: boolean) {
      const isCurrentlyOpen = navigation.classList.contains('is-open');
      const shouldOpen = show !== undefined ? show : !isCurrentlyOpen;

      if (shouldOpen) {
        navigation.classList.add('is-open');
        menuBackdrop?.classList.add('is-active');
        menuButton.setAttribute('aria-expanded', 'true');
        if (hamburgerIcon) (hamburgerIcon as HTMLElement).style.display = 'none';
        if (closeIcon) (closeIcon as HTMLElement).style.display = 'block';
        document.body.style.overflow = 'hidden';
      } else {
        navigation.classList.remove('is-open');
        menuBackdrop?.classList.remove('is-active');
        menuButton.setAttribute('aria-expanded', 'false');
        if (hamburgerIcon) (hamburgerIcon as HTMLElement).style.display = 'block';
        if (closeIcon) (closeIcon as HTMLElement).style.display = 'none';
        document.body.style.overflow = '';
      }
    }

    menuButton.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    };

    if (menuBackdrop) {
      menuBackdrop.onclick = (e) => {
        e.preventDefault();
        toggleMenu(false);
      };
    }

    const navLinks = navigation.querySelectorAll('a');
    navLinks.forEach(link => {
      link.onclick = () => toggleMenu(false);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
</script>

<style>
  .reference-home { --ink:#171743; --blue:#3835b9; --yellow:#ffd34d; --cream:#fcfaf6; --line:#e8e5df; background:var(--cream); color:var(--ink); font-family:'Poppins',sans-serif; }
  .section-shell { width:100%; margin:0; padding-inline:clamp(28px, 7vw, 96px); box-sizing:border-box; }
  .site-header { height:88px; width:100%; padding-inline:clamp(28px, 7vw, 96px); box-sizing:border-box; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:30px; }.brand { display:inline-flex; align-items:center; justify-content:flex-start; flex:none; width:92px; height:72px; overflow:visible; transform:translateY(4px); }.brand img { display:block; width:82px; height:72px; object-fit:contain; object-position:center; }.site-header nav { grid-column:2; display:flex; align-items:center; justify-content:center; gap:39px; font-size:14px; font-weight:600; }.site-header > .header-button { justify-self:end; }.site-header a { color:var(--ink); text-decoration:none; }.site-header nav > a { position:relative; padding:12px 0; }.site-header nav > a::after { content:""; position:absolute; left:0; right:100%; bottom:5px; height:2px; background:var(--blue); transition:right .25s ease; }.site-header nav > a:hover::after,.site-header nav > a:focus-visible::after { right:0; }.header-button { background:var(--yellow); border-radius:7px; padding:11px 20px; transition:transform .25s ease, background-color .25s ease, box-shadow .25s ease; }.header-button:hover,.header-button:focus-visible { background:#f7c832; box-shadow:0 8px 18px #ffd34d66; transform:translateY(-2px); }.menu-button { display:none; border:0; background:none; font-size:22px; color:var(--ink); }
  .hero { min-height:480px; display:grid; grid-template-columns:40% 60%; align-items:center; padding-top:4px; padding-bottom:34px; overflow:hidden; }.hero-copy { position:relative; z-index:1; padding-block:12px; }.eyebrow { margin:0 0 13px; color:#8a899c; font-size:9px; font-weight:700; letter-spacing:.2em; }.hero h1 { margin:0; color:var(--ink); font-size:clamp(42px, 4.2vw, 64px); line-height:1.04; letter-spacing:-.045em; }.hero h1 em { color:var(--blue); font-style:normal; }.hero-description { max-width:440px; margin:17px 0 19px; color:#66667b; font-size:13px; line-height:1.5; }.hero-actions { display:flex; align-items:center; flex-wrap:wrap; gap:25px; }.yellow-button { display:inline-flex; gap:14px; align-items:center; border:0; border-radius:7px; background:var(--yellow); color:var(--ink); padding:13px 18px; font-size:11px; font-weight:700; text-decoration:none; transition:transform .25s ease, background-color .25s ease, box-shadow .25s ease; }.yellow-button:hover,.yellow-button:focus-visible { background:#f7c832; box-shadow:0 10px 22px #ffd34d66; transform:translateY(-2px); }.yellow-button span,.text-link span { font-size:18px; line-height:0; transition:transform .25s ease; }.yellow-button:hover span,.yellow-button:focus-visible span,.text-link:hover span,.text-link:focus-visible span { transform:translateX(4px); }.text-link { display:inline-flex; align-items:center; gap:5px; color:var(--ink); font-size:10px; font-weight:700; text-decoration:none; border-bottom:1px solid #a8a6b4; padding:5px 0; transition:color .25s ease, border-color .25s ease; }.text-link:hover,.text-link:focus-visible { color:var(--blue); border-color:var(--blue); }.hero-tags { margin-top:24px; color:#9492a1; font-size:9px; letter-spacing:.08em; }.hero-visual { align-self:stretch; display:flex; align-items:center; justify-content:flex-end; }.hero-visual img { width:calc(100% + 80px); max-width:none; margin-right:clamp(-96px, -5vw, -40px); display:block; }
  .intro { display:grid; grid-template-columns:1fr 1.25fr; gap:45px; padding-block:48px 54px; border-top:1px solid var(--line); }.intro h2,.content-section h2,.process-section h2,.difference h2 { margin:0; font-size:28px; line-height:1.02; letter-spacing:-.04em; }.muted-copy { color:#797888; font-size:11px; line-height:1.45; }.proof-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }.proof-grid article,.service-card,.project-card { border:1px solid var(--line); border-radius:7px; background:rgba(255,255,255,.3); }.proof-grid article { min-height:128px; padding:17px 16px; display:flex; flex-direction:column; transition:transform .25s ease, border-color .25s ease, box-shadow .25s ease; }.proof-grid article:hover { transform:translateY(-4px); border-color:#b9b6e7; box-shadow:0 12px 24px #17174312; }.proof-icon { color:var(--blue); font-size:26px; line-height:1; margin-bottom:10px; }.proof-grid strong { font-size:10px; line-height:1.2; }.proof-grid small { margin-top:auto; color:#858391; font-size:8px; line-height:1.35; }
  .content-section { padding-block:48px 54px; border-top:1px solid var(--line); }.section-heading { display:flex; justify-content:space-between; align-items:end; gap:20px; margin-bottom:25px; padding-inline:8px; }.section-heading h2 { font-size:24px; }.service-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }.service-card { min-height:86px; padding:18px 20px; display:flex; align-items:center; gap:14px; position:relative; transition:transform .25s ease, border-color .25s ease, box-shadow .25s ease, background-color .25s ease; }.service-card:hover { transform:translateY(-4px); border-color:#b9b6e7; background:white; box-shadow:0 12px 24px #17174312; }.service-icon { display:grid; place-items:center; width:34px; height:34px; flex:none; color:white; background:var(--blue); border-radius:6px; transition:transform .25s ease, background-color .25s ease; }.service-icon svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }.service-card:hover .service-icon { transform:rotate(-6deg) scale(1.08); background:var(--ink); }.service-card h3 { margin:0 0 5px; font-size:11px; }.service-card p,.project-info p { margin:0; color:#7b7a89; font-size:8px; line-height:1.45; }.circle-arrow { display:grid; place-items:center; width:28px; height:28px; margin-left:auto; flex:none; border-radius:50%; background:#f1eff0; font-size:16px; transition:transform .25s ease, background-color .25s ease, color .25s ease; }.service-card:hover .circle-arrow,.project-card:hover .circle-arrow { transform:translateX(3px); background:var(--yellow); color:var(--ink); }.project-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }.project-card { overflow:hidden; transition:transform .3s ease, border-color .3s ease, box-shadow .3s ease; }.project-card:hover { transform:translateY(-5px); border-color:#b9b6e7; box-shadow:0 15px 28px #17174314; }.project-image { height:155px; overflow:hidden; background:#ddd; }.project-image img { width:100%; height:100%; object-fit:cover; object-position:top; transition:transform .5s ease; }.project-card:hover .project-image img { transform:scale(1.05); }.project-info { display:flex; gap:12px; padding:16px 18px 18px; }.project-info h3 { margin:0; font-size:11px; }.project-type { color:var(--blue)!important; margin:3px 0 5px!important; }.project-info .circle-arrow { align-self:center; }
  .process-section { padding-block:48px 54px; border-top:1px solid var(--line); }.process-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:34px; margin-top:32px; }.process-grid article { position:relative; padding:4px 12px 4px 34px; transition:transform .25s ease; }.process-grid article:hover { transform:translateY(-3px); }.process-number { position:absolute; left:0; top:0; color:#9997a6; font-size:18px; }.process-symbol { display:inline-grid; place-items:center; width:22px; height:22px; color:var(--blue); }.process-symbol svg { width:19px; height:19px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }.process-grid h3 { margin:8px 0 5px; font-size:11px; }.process-grid p { margin:0; color:#777686; font-size:8px; line-height:1.4; }.process-grid article:not(:last-child)::after { content:'→'; position:absolute; right:-21px; top:9px; color:#c3c0c0; }
  .difference { display:grid; grid-template-columns:34% 66%; align-items:center; min-height:280px; border-top:1px solid var(--line); padding-left:0; }.difference-visual { align-self:stretch; overflow:hidden; }.difference-visual img { display:block; width:100%; height:100%; object-fit:cover; object-position:35% center; }.difference-copy { position:relative; padding:42px clamp(28px, 7vw, 96px) 42px clamp(28px, 5vw, 72px); }.difference-copy h2 { max-width:540px; font-size:clamp(25px, 2.3vw, 36px); }.difference-description { max-width:520px; margin:13px 0 22px; color:#747386; font-size:12px; line-height:1.45; }.difference-points { display:grid; grid-template-columns:repeat(4, auto); gap:14px; margin-top:0; font-size:9px; font-weight:700; }.difference-points span { display:flex; align-items:center; gap:6px; white-space:nowrap; }.difference-points svg { width:17px; height:17px; flex:none; fill:none; stroke:var(--ink); stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }.difference-note { position:absolute; right:clamp(24px, 4vw, 64px); top:38px; color:#77768a; font-size:10px; font-style:italic; line-height:1.35; transform:rotate(-6deg); }.difference-note em { color:var(--blue); font-style:normal; }.final-cta { display:flex; justify-content:space-between; align-items:center; gap:30px; padding:27px clamp(28px, 7vw, 96px); box-sizing:border-box; color:white; background:var(--ink); }.final-cta .eyebrow { color:#aaa9bf; }.final-cta h2 { margin:0; font-size:24px; line-height:1.05; color:white; }.site-footer { width:100%; padding:0 clamp(28px, 7vw, 96px) 24px; box-sizing:border-box; background:var(--cream); overflow:hidden; }.footer-main { position:relative; min-height:152px; display:grid; grid-template-columns:1.15fr auto auto 1fr; align-items:center; gap:clamp(24px, 4vw, 68px); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }.footer-brand { position:relative; z-index:1; display:flex; flex-direction:column; align-items:flex-start; gap:4px; }.