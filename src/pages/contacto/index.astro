---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import logoImage from "../../assets/images/wairi_logo_primary_transparent.png";

const currentYear = new Date().getFullYear();
---

<Layout
  title="Contacto | Wairi"
  description="Hablemos de tu proyecto. Cuéntanos sobre tu negocio y te ayudamos a convertir ideas en experiencias digitales que generan resultados."
>
<div class="contact-page">

  <!-- NAVBAR (mismo que ReferenceHome) -->
  <header class="site-header">
    <a href="/" class="brand" aria-label="Wairi, inicio">
      <Image src={logoImage} alt="Wairi" width={224} height={178} />
    </a>
    <nav id="main-nav" aria-label="Navegación principal">
      <a href="/">Inicio</a>
      <a href="/#services">Servicios</a>
      <a href="/#projects">Proyectos</a>
      <a href="/#process">Nosotros</a>
      <a href="/contacto" class="nav-active">Contacto</a>
    </nav>
    <a href="/contacto" class="header-button">Hablemos</a>
    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-nav">
      <svg class="hamburger-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>
      <svg class="close-icon" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </header>
  <div class="menu-backdrop" id="menu-backdrop" aria-hidden="true"></div>
  <script is:inline>
    (function() {
      function initContactoMenu() {
        var menuBtn = document.querySelector('.site-header .menu-button');
        var nav = document.querySelector('.site-header nav');
        var backdrop = document.getElementById('menu-backdrop');
        if (!menuBtn || !nav) return;

        var hamburgerIcon = menuBtn.querySelector('.hamburger-icon');
        var closeIcon = menuBtn.querySelector('.close-icon');

        function toggleMenu(show) {
          var isCurrentlyOpen = nav.classList.contains('is-open');
          var shouldOpen = show !== undefined ? show : !isCurrentlyOpen;

          if (shouldOpen) {
            nav.classList.add('is-open');
            if (backdrop) backdrop.classList.add('is-active');
            menuBtn.setAttribute('aria-expanded', 'true');
            if (hamburgerIcon) hamburgerIcon.style.display = 'none';
            if (closeIcon) closeIcon.style.display = 'block';
            document.body.style.overflow = 'hidden';
          } else {
            nav.classList.remove('is-open');
            if (backdrop) backdrop.classList.remove('is-active');
            menuBtn.setAttribute('aria-expanded', 'false');
            if (hamburgerIcon) hamburgerIcon.style.display = 'block';
            if (closeIcon) closeIcon.style.display = 'none';
            document.body.style.overflow = '';
          }
        }

        menuBtn.onclick = function(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          toggleMenu();
        };

        if (backdrop) {
          backdrop.onclick = function(e) {
            if (e) e.preventDefault();
            toggleMenu(false);
          };
        }

        var navLinks = nav.querySelectorAll('a');
        for (var i = 0; i < navLinks.length; i++) {
          navLinks[i].onclick = function() {
            toggleMenu(false);
          };
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initContactoMenu);
      } else {
        initContactoMenu();
      }
    })();
  </script>

  <main id="main-content">

    <!-- HERO SECTION -->
    <section class="contact-hero section-shell">
      <div class="hero-copy">
        <p class="eyebrow">IDEAS DIGITALES. NEGOCIOS REALES.</p>
        <h1>Hablemos de<br /><em>tu proyecto.</em></h1>
        <p class="hero-desc">Cuéntanos sobre tu negocio, tus objetivos y lo que tienes en mente. En Wairi te ayudamos a convertir ideas en experiencias digitales que generan resultados.</p>
        <div class="hero-badges">
          <span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><circle cx="12" cy="12" r="10" fill="var(--blue)"/><path d="M7 12.5l3.5 3.5 6.5-7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Sin compromisos</span>
          <span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><circle cx="12" cy="12" r="10" fill="var(--blue)"/><path d="M7 12.5l3.5 3.5 6.5-7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Respuesta rápida</span>
          <span><svg viewBox="0 0 24 24" aria-hidden="true" fill="none"><circle cx="12" cy="12" r="10" fill="var(--blue)"/><path d="M7 12.5l3.5 3.5 6.5-7" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Enfoque en resultados</span>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-img-placeholder">
          <img src="/images/contacthero.png" alt="Equipo Wairi" loading="eager" />
        </div>
      </div>
    </section>

    <!-- FORM + SIDEBAR SECTION -->
    <section class="contact-body section-shell">

      <!-- FORM -->
      <div class="contact-form-wrap">
        <p class="eyebrow">CUÉNTANOS SOBRE TU PROYECTO</p>
        <h2>Completa el formulario</h2>
        <p class="form-subtitle">Mientras más claro seas, mejor podremos ayudarte. Nos pondremos en contacto contigo lo antes posible.</p>

        <!-- FORM WRAPPER with overlay -->
        <div class="form-wrapper" id="form-wrapper">
          <!-- SUCCESS OVERLAY -->
          <div class="form-success" id="form-success" aria-live="polite">
            <div class="form-success-icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="11" fill="#22c55e"/>
                <path d="M6 12.5l4 4 8-8" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>¡Mensaje enviado!</h3>
            <p>Gracias por escribirnos. Revisaremos tu consulta y te responderemos en menos de 24 horas a tu correo.</p>
          </div>

          <form class="contact-form" id="contact-form" method="POST" action="https://formspree.io/f/xreylozj" novalidate>
            <div class="form-honeypot" aria-hidden="true">
              <label for="website">Website</label>
              <input type="text" id="website" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>
            <p class="form-error" id="form-error" role="alert" hidden></p>
            <div class="form-row">
              <div class="form-field">
                <label for="nombre">Nombre</label>
                <div class="input-wrap">
                  <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <input type="text" id="nombre" name="nombre" placeholder="Tu nombre completo" autocomplete="name" />
                </div>
              </div>
              <div class="form-field">
                <label for="negocio">Negocio o empresa</label>
                <div class="input-wrap">
                  <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
                  <input type="text" id="negocio" name="negocio" placeholder="Nombre de tu negocio" autocomplete="organization" />
                </div>
              </div>
            </div>
            <div class="form-row">
              <div class="form-field">
                <label for="email">Email</label>
                <div class="input-wrap">
                  <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  <input type="email" id="email" name="email" placeholder="tu@correo.com" autocomplete="email" required />
                </div>
              </div>
              <div class="form-field">
                <label for="telefono">Teléfono <span class="label-opt">(opcional)</span></label>
                <div class="input-wrap">
                  <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 3.09 5.18 2 2 0 0 1 5.06 3h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11l-1.27 1.27a16 16 0 0 0 6.78 6.78l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
                  <input type="tel" id="telefono" name="telefono" placeholder="+51 999 999 999" autocomplete="tel" />
                </div>
              </div>
            </div>
            <div class="form-row">
              <div class="form-field">
                <label for="servicio">Servicio de interés</label>
                <div class="select-wrap">
                  <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                  <select id="servicio" name="servicio">
                    <option value="" disabled selected>Selecciona un servicio</option>
                    <option>Página web</option>
                    <option>Sistema a medida</option>
                    <option>Ecommerce</option>
                    <option>Estrategia digital</option>
                    <option>Otro</option>
                  </select>
                  <span class="select-arrow">▾</span>
                </div>
              </div>
              <div class="form-field">
                <label for="presupuesto">Presupuesto estimado</label>
                <div class="select-wrap">
                  <svg class="input-icon" viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  <select id="presupuesto" name="presupuesto">
                    <option value="" disabled selected>Selecciona un rango</option>
                    <option>Menos de $500</option>
                    <option>$500 – $1,500</option>
                    <option>$1,500 – $5,000</option>
                    <option>Más de $5,000</option>
                  </select>
                  <span class="select-arrow">▾</span>
                </div>
              </div>
            </div>
            <div class="form-field form-field-full">
              <label for="mensaje">Mensaje</label>
              <div class="input-wrap input-wrap-textarea">
                <textarea id="mensaje" name="mensaje" rows="5" placeholder="Cuéntanos más sobre tu proyecto, tus objetivos o cualquier pregunta que tengas..." maxlength="500"></textarea>
              </div>
              <span class="char-count">0/500</span>
            </div>
            <button type="submit" class="submit-button" id="submit-btn">
              <span class="btn-text">Enviar consulta →</span>
              <span class="btn-loading" hidden>Enviando...</span>
            </button>
            <p class="form-privacy">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Tu información está segura y solo será utilizada para fines comerciales.
            </p>
          </form>
        </div>
      </div>

      <!-- SIDEBAR -->
      <aside class="contact-sidebar">
        <span class="sidebar-shape sidebar-shape-1" aria-hidden="true"></span>
        <span class="sidebar-shape sidebar-shape-2" aria-hidden="true"></span>
        <p class="eyebrow sidebar-eyebrow">ESTAMOS AQUÍ PARA TI</p>
        <h2 class="sidebar-title">Un equipo listo<br />para escucharte.</h2>
        <p class="sidebar-desc">Ya sea que tengas una idea clara o solo estés explorando opciones, escríbenos. Te ayudaremos a encontrar el mejor camino para tu negocio.</p>

        <div class="contact-items">
          <div class="contact-item">
            <span class="contact-item-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <div>
              <p class="contact-item-label">Correo</p>
              <a href="mailto:somoswairi@gmail.com" class="contact-item-value contact-email-link">somoswairi@gmail.com</a>
              <p class="contact-item-note">Escríbenos cuando quieras. Estamos para ayudarte.</p>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-item-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </span>
            <div>
              <p class="contact-item-label">Tiempo de respuesta</p>
              <p class="contact-item-value">Menos de 24 horas</p>
              <p class="contact-item-note">Te responderemos lo antes posible, normalmente el mismo día.</p>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-item-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <div>
              <p class="contact-item-label">Qué puedes esperar</p>
              <p class="contact-item-value">Una conversación real</p>
              <p class="contact-item-note">Sin rodeos. Hablaremos sobre tus objetivos y te daremos una visión clara de los próximos pasos.</p>
            </div>
          </div>
        </div>

        <p class="sidebar-handwritten">Más negocios reales.</p>
      </aside>

    </section>

    <!-- PROCESO SECTION -->
    <section class="next-section">
      <div class="next-section-inner section-shell">
        <p class="eyebrow next-eyebrow">UN PROCESO SIMPLE Y TRANSPARENTE</p>
        <h2>¿Qué pasa <strong>después?</strong></h2>
        <p class="next-subtitle">Así es como convertimos tu mensaje en grandes oportunidades.</p>

        <div class="next-steps">
          <div class="next-step">
            <span class="step-badge">01</span>
            <span class="step-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </span>
            <h3>Te contactamos</h3>
            <p>Revisamos tu consulta y te respondemos en menos de 24 horas.</p>
          </div>
          <span class="step-arrow" aria-hidden="true">→</span>
          <div class="next-step">
            <span class="step-badge">02</span>
            <span class="step-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <h3>Conversamos</h3>
            <p>Agendamos una llamada o reunión para entender mejor tu proyecto.</p>
          </div>
          <span class="step-arrow" aria-hidden="true">→</span>
          <div class="next-step">
            <span class="step-badge">03</span>
            <span class="step-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8l4 4-4 4M8 12h8"/></svg>
            </span>
            <h3>Trazamos el camino</h3>
            <p>Te proponemos una solución a medida y empezamos a hacerlo realidad.</p>
          </div>
        </div>
      </div>
      <!-- decoraciones geométricas de fondo -->
      <span class="next-deco next-deco-1" aria-hidden="true"></span>
      <span class="next-deco next-deco-2" aria-hidden="true"></span>
      <span class="next-deco next-deco-3" aria-hidden="true"></span>
    </section>

  </main>

  <!-- FOOTER (mismo que ReferenceHome) -->
  <footer class="site-footer">
    <div class="footer-main">
      <div class="footer-brand">
        <Image src={logoImage} alt="Wairi" width={224} height={178} />
        <span>IDEAS DIGITALES. NEGOCIOS REALES.</span>
        <p>Diseñamos experiencias digitales que hacen crecer negocios reales.</p>
      </div>
      <nav class="footer-nav" aria-label="Navegación del pie de página">
        <div>
          <strong>Explora</strong>
          <a href="/">Inicio</a>
          <a href="/#services">Servicios</a>
          <a href="/#projects">Proyectos</a>
          <a href="/#process">Proceso</a>
        </div>
        <div>
          <strong>Soluciones</strong>
          <a href="/#services">Páginas web</a>
          <a href="/#services">Sistemas a medida</a>
          <a href="/#services">Ecommerce</a>
          <a href="/contacto">Hablemos</a>
        </div>
      </nav>
      <div class="footer-contact">
        <strong>Conectemos</strong>
        <a href="mailto:somoswairi@gmail.com">somoswairi@gmail.com</a>
        <a href="tel:+51955730223">+51 955 730 223</a>
        <div class="socials" aria-label="Redes sociales">
          <a href="https://www.instagram.com/innerneoficial/" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"/></svg>
          </a>
          <a href="https://www.tiktok.com" aria-label="TikTok">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.5a3.5 3.5 0 1 1-3-3.46M14 4c.7 2.2 2.1 3.5 4.5 3.7"/></svg>
          </a>
          <a href="https://www.linkedin.com" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9v9M6 6v.1M10 18v-5a3 3 0 0 1 6 0v5M10 9v9"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-message">Construimos<br /><em>lo que sigue.</em><span></span></div>
    </div>
    <div class="footer-bottom">
      <span>© {currentYear} Wairi. Todos los derechos reservados.</span>
      <div>
        <a href="#">Términos</a>
        <a href="#">Privacidad</a>
        <a href="/contacto">Contacto</a>
      </div>
    </div>
  </footer>

</div>

<script>
  import { ValidationError } from 'yup';
  import {
    contactFormSchema,
    getFormValues,
    sanitizeContactData,
  } from '../../lib/contactForm';

  const textarea = document.querySelector('#mensaje') as HTMLTextAreaElement;
  const counter = document.querySelector('.char-count');
  textarea?.addEventListener('input', () => {
    if (counter) counter.textContent = `${textarea.value.length}/500`;
  });

  const form = document.querySelector('#contact-form') as HTMLFormElement;
  const successOverlay = document.querySelector('#form-success') as HTMLElement;
  const submitBtn = document.querySelector('#submit-btn') as HTMLButtonElement;
  const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement;
  const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLElement;
  const formError = document.querySelector('#form-error') as HTMLElement;

  const showError = (message: string) => {
    if (!formError) return;
    formError.textContent = message;
    formError.hidden = false;
  };

  const clearError = () => {
    if (!formError) return;
    formError.textContent = '';
    formError.hidden = true;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();

    const rawValues = getFormValues(form);

    if (rawValues._gotcha) {
      successOverlay.classList.add('is-visible');
      form.reset();
      if (counter) counter.textContent = '0/500';
      setTimeout(() => successOverlay.classList.remove('is-visible'), 1800);
      return;
    }

    let validated;
    try {
      validated = await contactFormSchema.validate(rawValues, {
        abortEarly: false,
        stripUnknown: true,
      });
    } catch (error) {
      if (error instanceof ValidationError) {
        showError(error.errors.join(' • '));
      } else {
        showError('Revisa los datos del formulario e inténtalo de nuevo.');
      }
      return;
    }

    const sanitized = sanitizeContactData(validated);
    const payload = new FormData();
    for (const [key, value] of Object.entries(sanitized)) {
      if (key !== '_gotcha' && value) payload.append(key, value);
    }

    btnText.hidden = true;
    btnLoading.hidden = false;
    submitBtn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: payload,
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        successOverlay.classList.add('is-visible');
        form.reset();
        if (counter) counter.textContent = '0/500';
        setTimeout(() => successOverlay.classList.remove('is-visible'), 1800);
      } else {
        showError('No pudimos enviar tu mensaje. Inténtalo de nuevo.');
      }
    } catch {
      showError('Error de conexión. Inténtalo de nuevo.');
    } finally {
      btnText.hidden = false;
      btnLoading.hidden = true;
      submitBtn.disabled = false;
    }
  });
</script>

<style>
  .contact-page {
    --ink: #171743;
    --blue: #3835b9;
    --yellow: #ffd34d;
    --cream: #fcfaf6;
    --line: #e8e5df;
    background: var(--cream);
    color: var(--ink);
    font-family: 'Poppins', sans-serif;
  }

  /* ── SHARED ── */
  .section-shell { width: 100%; margin: 0; padding-inline: clamp(28px, 7vw, 96px); box-sizing: border-box; }
  .eyebrow { margin: 0 0 13px; color: #8a899c; font-size: 9px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }

  /* ── NAVBAR ── */
  .site-header { height: 88px; width: 100%; padding-inline: clamp(28px, 7vw, 96px); box-sizing: border-box; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 30px; border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; justify-content: flex-start; flex: none; width: 92px; height: 72px; overflow: visible; transform: translateY(4px); }
  .brand img { display: block; width: 82px; height: 72px; object-fit: contain; }
  .site-header nav { grid-column: 2; display: flex; align-items: center; justify-content: center; gap: 39px; font-size: 14px; font-weight: 600; }
  .site-header > .header-button { justify-self: end; }
  .site-header a { color: var(--ink); text-decoration: none; }
  .site-header nav > a { position: relative; padding: 12px 0; }
  .site-header nav > a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: 5px; height: 2px; background: var(--blue); transition: right .25s ease; }
  .site-header nav > a:hover::after, .site-header nav > a:focus-visible::after, .nav-active::after { right: 0 !important; }
  .nav-active { color: var(--blue) !important; }
  .header-button { background: var(--yellow); border-radius: 7px; padding: 13px 25px; font-size: 14px; font-weight: 700; letter-spacing: .07em; transition: transform .25s ease, background-color .25s ease, box-shadow .25s ease; }
  .header-button:hover { background: #f7c832; box-shadow: 0 8px 18px #ffd34d66; transform: translateY(-2px); }
  .menu-button { display: none; border: 0; background: none; font-size: 22px; color: var(--ink); cursor: pointer; }

  /* ── HERO ── */
  .contact-hero { display: grid; grid-template-columns: 45% 55%; align-items: center; gap: 20px; padding-block: 36px 32px; border-bottom: 1px solid var(--line); }
  .hero-copy h1 { margin: 0 0 14px; font-size: clamp(36px, 4vw, 58px); line-height: 1.02; letter-spacing: -.045em; }
  .hero-copy h1 em { color: var(--blue); font-style: normal; }
  .hero-desc { max-width: 440px; margin: 0 0 18px; color: #66657a; font-size: 14px; line-height: 1.55; }
  .hero-badges { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-badges span { display: flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 600; color: #555468; }
  .hero-badges svg { width: 20px; height: 20px; flex: none; }
  .hero-visual { position: relative; }
  .hero-img-placeholder { position: relative; border-radius: 16px; overflow: hidden; display: flex; align-items: stretch; }
  .hero-img-placeholder img { width: 100%; height: auto; max-height: 500px; object-fit: contain; object-position: center; border-radius: 16px; display: block; }
  .float-card { position: absolute; background: white; border-radius: 12px; box-shadow: 0 8px 28px rgba(23,23,67,.13); padding: 16px 18px; z-index: 2; }
  .float-card-left { left: -24px; bottom: 60px; max-width: 140px; }
  .float-card-left .float-icon { font-size: 22px; display: block; margin-bottom: 8px; }
  .float-card-left p { margin: 0; font-size: 11px; font-weight: 700; line-height: 1.35; color: var(--ink); }
  .float-card-right { right: -16px; top: 50px; min-width: 150px; }
  .float-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .float-list li { display: flex; align-items: center; gap: 9px; font-size: 12px; font-weight: 600; color: var(--ink); }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .dot-yellow { background: var(--yellow); }
  .dot-blue { background: var(--blue); }
  .hero-handwritten { position: absolute; right: -10px; top: -32px; font-size: 11px; font-style: italic; color: #77768a; line-height: 1.4; transform: rotate(4deg); text-align: right; pointer-events: none; }

  /* ── FORM + SIDEBAR ── */
  .contact-body { display: grid; grid-template-columns: 1fr 420px; gap: 48px; padding-block: 64px; align-items: start; border-bottom: 1px solid var(--line); }
  .contact-form-wrap h2 { margin: 8px 0 10px; font-size: clamp(28px, 3vw, 40px); letter-spacing: -.04em; }
  .form-subtitle { margin: 0 0 32px; color: #66657a; font-size: 13px; line-height: 1.5; max-width: 460px; }
  .contact-form { display: flex; flex-direction: column; gap: 20px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-field { display: flex; flex-direction: column; gap: 7px; }
  .form-field-full { grid-column: 1 / -1; }
  .form-field label { font-size: 12px; font-weight: 600; color: var(--ink); }
  .label-opt { font-weight: 400; color: #9998b0; }
  /* input wrap with icon */
  .input-wrap { position: relative; display: flex; align-items: center; }
  .input-icon { position: absolute; left: 13px; width: 16px; height: 16px; fill: none; stroke: #b5b3c8; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; pointer-events: none; flex: none; z-index: 1; transition: stroke .2s ease; }
  .input-wrap:focus-within .input-icon { stroke: var(--blue); }
  .form-field input, .form-field textarea { width: 100%; border: 1.5px solid #e0ddd8; border-radius: 10px; padding: 13px 14px 13px 40px; font-size: 13px; font-family: 'Poppins', sans-serif; color: var(--ink); background: white; transition: border-color .2s ease, box-shadow .2s ease, background .2s ease; outline: none; resize: none; box-sizing: border-box; }
  .form-field textarea { padding-left: 14px; min-height: 120px; }
  .input-wrap-textarea .input-icon { display: none; }
  .form-field input::placeholder, .form-field textarea::placeholder { color: #b5b3c8; }
  .form-field input:hover, .form-field textarea:hover { border-color: #c8c5e0; background: #fdfcff; }
  .form-field input:focus, .form-field textarea:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(56,53,185,.1); background: white; }
  .select-wrap { position: relative; display: flex; align-items: center; }
  .select-wrap .input-icon { left: 13px; }
  .select-wrap select { width: 100%; appearance: none; border: 1.5px solid #e0ddd8; border-radius: 10px; padding: 13px 36px 13px 40px; font-size: 13px; font-family: 'Poppins', sans-serif; color: var(--ink); background: white; cursor: pointer; outline: none; transition: border-color .2s ease, box-shadow .2s ease; }
  .select-wrap select:hover { border-color: #c8c5e0; }
  .select-wrap select:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(56,53,185,.1); }
  .select-arrow { position: absolute; right: 13px; pointer-events: none; font-size: 13px; color: #b5b3c8; }
  .char-count { align-self: flex-end; font-size: 10px; color: #b5b3c8; margin-top: -8px; }
  .submit-button { background: var(--yellow); color: var(--ink); border: none; border-radius: 10px; padding: 16px 28px; font-size: 15px; font-weight: 700; font-family: 'Poppins', sans-serif; cursor: pointer; transition: transform .25s ease, background-color .25s ease, box-shadow .25s ease; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .submit-button:hover:not(:disabled) { background: #f7c832; box-shadow: 0 10px 22px #ffd34d66; transform: translateY(-2px); }
  .submit-button:disabled { opacity: .7; cursor: not-allowed; }
  .form-privacy { display: flex; align-items: center; gap: 8px; font-size: 11px; color: #9998b0; margin: 0; }
  .form-privacy svg { width: 14px; height: 14px; fill: none; stroke: #9998b0; stroke-width: 1.8; flex: none; }
  .form-honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none; }
  .form-error { margin: 0; padding: 12px 14px; border-radius: 10px; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; font-size: 12px; line-height: 1.45; }
  /* success state — overlay sobre el formulario */
  .form-wrapper { position: relative; }
  .form-success {
    position: absolute; inset: 0; z-index: 10;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; gap: 14px;
    background: rgba(252,250,246,.97); backdrop-filter: blur(4px);
    border: 1.5px solid #d4f5e2; border-radius: 16px;
    padding: 48px 32px;
    opacity: 0; pointer-events: none;
    transition: opacity .3s ease;
  }
  .form-success.is-visible { opacity: 1; pointer-events: auto; }
  .form-success-icon svg { width: 64px; height: 64px; display: block; }
  .form-success h3 { margin: 0; font-size: 22px; color: var(--ink); }
  .form-success p { margin: 0; font-size: 13px; color: #66657a; line-height: 1.55; max-width: 360px; }

  /* SIDEBAR */
  .contact-sidebar { position: relative; overflow: hidden; background: var(--blue); border-radius: 16px; padding: 36px 32px 32px; color: white; }
  .contact-sidebar > * { position: relative; z-index: 1; }
  /* formas geométricas del sidebar */
  .contact-sidebar::before { content: ""; position: absolute; width: 160px; height: 160px; border-radius: 50%; background: rgba(255,255,255,.07); top: -50px; right: -40px; pointer-events: none; }
  .contact-sidebar::after { content: ""; position: absolute; width: 90px; height: 90px; background: rgba(255,211,77,.15); bottom: 30px; left: -20px; border-radius: 14px; transform: rotate(30deg); pointer-events: none; }
  .sidebar-shape { position: absolute; z-index: 0; pointer-events: none; }
  .sidebar-shape-1 { width: 60px; height: 60px; border: 2px solid rgba(255,255,255,.1); border-radius: 50%; bottom: 80px; right: 24px; }
  .sidebar-shape-2 { width: 40px; height: 40px; background: rgba(56,53,185,.6); border-radius: 8px; transform: rotate(45deg); top: 120px; right: -10px; }
  .sidebar-eyebrow { color: #a8a6d8; }
  .sidebar-title { margin: 8px 0 14px; font-size: clamp(22px, 2.3vw, 30px); font-weight: 400; line-height: 1.12; letter-spacing: -.03em; color: white; }
  .sidebar-desc { font-size: 13px; line-height: 1.55; color: #c4c2e0; margin: 0 0 28px; }
  .contact-items { display: flex; flex-direction: column; gap: 22px; }
  .contact-item { display: flex; gap: 16px; align-items: flex-start; }
  .contact-item-icon { display: grid; place-items: center; width: 44px; height: 44px; flex: none; background: rgba(255,255,255,.15); border-radius: 50%; }
  .contact-item-icon svg { width: 20px; height: 20px; fill: none; stroke: white; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .contact-item-label { margin: 0 0 2px; font-size: 10px; color: #a8a6d8; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .contact-item-value { margin: 0 0 4px; font-size: 15px; font-weight: 700; color: white; word-break: break-all; overflow-wrap: anywhere; text-decoration: none; display: block; }
  .contact-email-link:hover { text-decoration: underline; }
  .contact-item-note { margin: 0; font-size: 11px; color: #c4c2e0; line-height: 1.45; }
  .sidebar-handwritten { margin: 28px 0 0; font-size: 15px; font-style: italic; color: var(--yellow); text-align: right; transform: rotate(-3deg); display: block; }

  /* ── NEXT STEPS ── */
  .next-section { position: relative; overflow: hidden; background: #0f1135; }
  .next-section-inner { position: relative; z-index: 1; padding-block: 72px 80px; text-align: center; }
  .next-eyebrow { color: #5a5d8a; letter-spacing: .22em; }
  .next-section h2 { margin: 10px 0 14px; font-size: clamp(34px, 4vw, 54px); font-weight: 300; letter-spacing: -.04em; color: white; }
  .next-section h2 strong { font-weight: 700; }
  .next-subtitle { margin: 0 0 56px; color: #7c7ea8; font-size: 15px; line-height: 1.5; }
  .next-steps { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 0; max-width: 960px; margin: 0 auto; }
  .next-step { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding: 32px 28px 36px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 16px; text-align: left; transition: background .25s, border-color .25s; }
  .next-step:hover { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.14); }
  .step-badge { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: #f5d97a; color: var(--ink); font-size: 13px; font-weight: 800; flex: none; }
  .step-icon { display: grid; place-items: center; width: 52px; height: 52px; border: 1.5px solid rgba(255,255,255,.18); border-radius: 50%; background: transparent; }
  .step-icon svg { width: 22px; height: 22px; fill: none; stroke: rgba(255,255,255,.75); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .next-step h3 { margin: 0; font-size: 16px; font-weight: 700; color: white; }
  .next-step p { margin: 0; font-size: 13px; color: #8082aa; line-height: 1.6; }
  .step-arrow { display: flex; align-items: center; justify-content: center; width: 56px; font-size: 18px; color: rgba(255,255,255,.2); flex: none; padding: 0 4px; }
  /* decoraciones geométricas next-section */
  .next-deco { position: absolute; pointer-events: none; border-radius: 50%; }
  .next-deco-1 { width: 260px; height: 260px; background: rgba(36,33,160,.6); top: -80px; right: -40px; }
  .next-deco-2 { width: 130px; height: 130px; background: rgba(36,33,160,.5); bottom: -40px; left: -30px; }
  .next-deco-3 { display: none; }

  /* ── FOOTER ── */
  .site-footer { width: 100%; padding: 0 clamp(28px, 7vw, 96px) 24px; box-sizing: border-box; background: var(--cream); }
  .footer-main { position: relative; min-height: 0; height: auto; display: grid; grid-template-areas: "brand nav contact message"; grid-template-columns: minmax(260px, 1.3fr) minmax(300px, 1.15fr) minmax(230px, .9fr) minmax(180px, .7fr); align-items: start; gap: clamp(26px, 4vw, 64px); padding: 38px 0 42px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .footer-main > * { position: relative; z-index: 1; min-width: 0; }
  .footer-brand { grid-area: brand; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .footer-brand img { display: block; width: 140px; height: 92px; object-fit: contain; }
  .footer-brand span { color: #5f5e76; font-size: 8px; font-weight: 600; letter-spacing: .13em; }
  .footer-brand p { max-width: 250px; margin: 8px 0 0; color: #5f5e76; font-size: 11px; line-height: 1.4; }
  .footer-nav { grid-area: nav; display: flex; gap: clamp(28px, 4vw, 54px); }
  .footer-nav div, .footer-contact { display: flex; flex-direction: column; align-items: flex-start; gap: 11px; }
  .footer-nav strong, .footer-contact strong { margin-bottom: 4px; color: var(--blue); font-size: 11px; text-transform: uppercase; letter-spacing: .12em; }
  .footer-main a { color: var(--ink); text-decoration: none; transition: color .2s ease; }
  .footer-nav a, .footer-contact > a { font-size: 12px; color: #5f5e76; word-break: break-all; overflow-wrap: anywhere; }
  .footer-nav a:hover, .footer-contact > a:hover { color: var(--blue); }
  .footer-contact { grid-area: contact; }
  .socials { display: flex; align-items: center; gap: 18px; }
  .socials a { display: grid; place-items: center; width: 22px; height: 22px; color: var(--ink); }
  .socials svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; transition: color .2s ease; }
  .socials a:hover svg { color: var(--blue); }
  .footer-message { grid-area: message; align-self: start; justify-self: start; font-size: 22px; font-weight: 700; line-height: 1.15; color: var(--ink); max-width: 170px; }
  .footer-message em { color: var(--blue); font-style: normal; }
  .footer-message span { display: block; width: 58px; height: 5px; margin-top: 9px; border-radius: 4px; background: var(--yellow); }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; padding-top: 17px; color: #77768a; font-size: 11px; }
  .footer-bottom div { display: flex; gap: 28px; }
  .footer-bottom a { color: inherit; text-decoration: none; transition: color .2s ease; }
  .footer-bottom a:hover { color: var(--blue); }

  /* ── RESPONSIVE ── */
  .menu-backdrop { display: none; }

  @media (max-width: 900px) {
    .contact-body { grid-template-columns: 1fr; }
    .contact-sidebar { order: -1; }
  }
  @media (max-width: 760px) {
    .menu-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(15, 17, 44, 0.65);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 98;
    }
    .menu-backdrop.is-active {
      opacity: 1;
      pointer-events: auto;
    }

    .contact-page {
      width: 100%;
      max-width: 100%;
      overflow-x: clip;
    }
    .contact-page main,
    .section-shell,
    .site-header,
    .site-footer {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      height: 72px;
      padding-inline: 18px;
      grid-template-columns: 1fr auto;
      background: #fcfaf6;
    }
    .brand {
      grid-column: 1;
      width: 72px;
      height: 56px;
      transform: translateY(2px);
    }
    .brand img {
      width: 64px;
      height: 56px;
    }
    .site-header > .header-button { display: none; }
    .menu-button {
      display: flex;
      align-items: center;
      justify-content: center;
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      align-self: center;
      width: 44px;
      height: 44px;
      padding: 0;
      margin: 0;
      border: none;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
      z-index: 101;
    }
    .menu-button svg {
      width: 26px;
      height: 26px;
      stroke: var(--ink);
      display: block;
    }
    .site-header nav {
      display: none;
      position: fixed;
      top: 72px;
      left: 0;
      right: 0;
      width: 100%;
      padding: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fcfaf6;
      border-radius: 0;
      border-bottom: 1px solid #e8e5df;
      box-shadow: 0 16px 36px rgba(23, 23, 67, 0.18);
      z-index: 100;
      transform: translateY(-8px);
      opacity: 0;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }
    .site-header nav.is-open {
      display: flex !important;
      opacity: 1;
      transform: translateY(0);
    }
    .site-header nav > a {
      width: 100%;
      font-size: 15px;
      font-weight: 600;
      color: var(--ink);
      padding: 15px 24px;
      border-bottom: 1px solid #e8e5df;
      box-sizing: border-box;
      text-decoration: none;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    .site-header nav > a:last-child {
      border-bottom: none;
    }
    .site-header nav > a:hover,
    .site-header nav > a:active {
      background-color: #f2eee7;
      color: var(--blue);
    }
    .contact-hero { grid-template-columns: 1fr; gap: 32px; padding-block: 40px 32px; }
    .hero-visual,
    .hero-img-placeholder {
      max-width: 100%;
      overflow: hidden;
    }
    .hero-img-placeholder { min-height: 260px; }
    .hero-img-placeholder img { max-width: 100%; }
    .float-card-left, .float-card-right, .hero-handwritten { display: none; }
    .section-shell { padding-inline: 18px; }
    .contact-body,
    .contact-form-wrap,
    .contact-sidebar,
    .form-wrapper {
      min-width: 0;
      max-width: 100%;
    }
    .form-row { grid-template-columns: 1fr; }
    .next-steps { grid-template-columns: 1fr; gap: 16px; }
    .step-arrow { display: none; }
    .site-footer { padding-inline: 18px; overflow-x: clip; }
    .footer-main {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
      padding-block: 32px;
    }
    .footer-brand,
    .footer-nav,
    .footer-contact,
    .footer-message {
      grid-area: auto;
      width: 100%;
    }
    .footer-brand img {
      width: 104px;
      height: 68px;
    }
    .footer-nav { flex-direction: column; gap: 28px; }
    .footer-message { max-width: none; justify-self: auto; padding: 0; }
    .footer-bottom { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
  :focus-visible { outline: 3px solid var(--yellow); outline-offset: 4px; }
  /* Override layout global background */
  body, html { background: #fcfaf6 !important; }
</style>
</Layout>
